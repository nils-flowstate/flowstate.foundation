---
import { Globe, Workflow, Video } from 'lucide-react'
import Button from '../ui/Button.astro'
import { localizePath, useTranslations, type Lang } from '../../i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const cards = [
  { id: 'website', Icon: Globe, iconClass: 'w-10 h-10 text-navy', n: 1, border: 'hover:border-navy' },
  { id: 'workflow', Icon: Workflow, iconClass: 'w-10 h-10 text-orange', n: 2, border: 'hover:border-orange' },
  { id: 'social-media', Icon: Video, iconClass: 'w-10 h-10 text-fire', n: 3, border: 'hover:border-fire' },
]
---
<section class="bg-surface py-20 px-4">
  <div class="max-w-5xl mx-auto">
    <h2 class="reveal font-display text-2xl sm:text-3xl font-bold text-navy text-center mb-12">
      {t('services.previewTitle')}
    </h2>

    <div data-stagger class="grid sm:grid-cols-3 gap-6">
      {cards.map(card => (
        <div class="reveal flex">
          <div class={`bg-white rounded-2xl p-6 border-2 border-transparent transition duration-200 hover:scale-[1.01] ${card.border} flex flex-col w-full`}>
            <div class="mb-4"><card.Icon className={card.iconClass} /></div>
            <h3 class="font-sans font-bold text-lg text-text mb-3">{t(`services.card${card.n}Title`)}</h3>
            <ul class="space-y-1 mb-3">
              {[1, 2, 3].map(s => (
                <li class="flex items-center gap-2 font-sans text-sm text-muted">
                  <span class="w-1.5 h-1.5 rounded-full bg-muted/40 shrink-0"></span>
                  {t(`services.card${card.n}Sub${s}`)}
                </li>
              ))}
            </ul>
            <p class="font-sans font-semibold text-sm text-navy mb-2">{t(`services.card${card.n}Tagline`)}</p>
            <p class="font-sans text-sm text-muted leading-relaxed mb-5 flex-1">{t(`services.card${card.n}Desc`)}</p>
            <Button
              href={localizePath('values', lang, card.id)}
              variant="ghost"
              size="sm"
              class="w-full border border-gray-200 text-navy hover:bg-surface"
            >
              {t('services.learnMore')}
            </Button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
