---
import { ChevronDown } from 'lucide-react'
import WhatsAppButton from '../ui/WhatsAppButton.astro'
import Bold from '../ui/Bold.astro'
import { useTranslations, type Lang } from '../../i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const s2c = t('vision.s2c')
const reveal = 'reveal'
const motion = '--y:24px; --dur:0.65s'
---
<section class="bg-hero-bg border-t border-white/[0.04] py-20 px-4">
  <div data-stagger="0.14" class="max-w-3xl mx-auto text-center">
    <p class={`${reveal} font-sans text-xs tracking-[0.2em] uppercase text-green mb-7`} style={motion}>
      {t('vision.label')}
    </p>

    <p class={`${reveal} font-display text-xl sm:text-2xl md:text-3xl text-white leading-relaxed`} style={motion}>
      {t('vision.s1a')}{' '}
      <span class="text-orange font-bold">{t('vision.s1bold1')}</span>{' '}
      {t('vision.s1b')}{' '}
      <span class="text-orange font-bold">{t('vision.s1bold2')}</span>
    </p>

    <p class={`${reveal} font-display italic text-white/60 text-base my-6`} style={motion}>
      {t('vision.connector')}
    </p>

    <p class={`${reveal} font-display text-xl sm:text-2xl md:text-3xl text-white leading-relaxed`} style={motion}>
      {t('vision.s2a')}{' '}
      <span class="text-green font-bold">{t('vision.s2bold1')}</span>{' '}
      {t('vision.s2b')}{' '}
      <span class="text-green font-bold">{t('vision.s2bold2')}</span>
      {s2c && <>{' '}{s2c}</>}
    </p>

    <div class={`${reveal} mt-10 border-t border-white/10 pt-8`} style={motion}>
      <div class="relative group/manifest rounded-xl overflow-hidden" data-manifest>
        <div class="absolute inset-0 bg-gradient-to-b from-orange/10 to-orange/[0.03] pointer-events-none transition-opacity duration-300 opacity-0 group-hover/manifest:opacity-100 group-data-[open]/manifest:opacity-100"></div>

        <button type="button" class="relative w-full px-4 py-4 text-center" aria-expanded="false" data-manifest-toggle>
          <p class="font-display italic text-xl sm:text-2xl text-white/85 leading-relaxed">
            <Bold text={t('vision.manifest.hook')} class="text-green" />
          </p>
          <span class="mt-3 mx-auto w-5 h-5 text-white/40 transition-transform duration-300 block group-data-[open]/manifest:rotate-180">
            <ChevronDown className="w-5 h-5" />
          </span>
        </button>

        <div class="relative grid grid-rows-[0fr] opacity-0 transition-all duration-[400ms] ease-out group-data-[open]/manifest:grid-rows-[1fr] group-data-[open]/manifest:opacity-100">
          <div class="overflow-hidden">
            <div class="px-4 pb-5 space-y-4 font-display italic text-xl sm:text-2xl text-white/75 leading-relaxed text-center">
              <p><Bold text={t('vision.manifest.p1')} class="text-green" /></p>
              <p><Bold text={t('vision.manifest.p2')} class="text-green" /></p>
              <p><Bold text={t('vision.manifest.p3')} class="text-green" /></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class={`${reveal} mt-8`} style={motion}>
      <WhatsAppButton
        label={t('vision.waLabel')}
        message="Ich fühle deine Mission, aber wie möchtest du das erreichen?"
      />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-manifest]').forEach(manifest => {
    const toggle = manifest.querySelector<HTMLButtonElement>('[data-manifest-toggle]')
    toggle?.addEventListener('click', () => {
      const open = !manifest.hasAttribute('data-open')
      manifest.toggleAttribute('data-open', open)
      toggle.setAttribute('aria-expanded', String(open))
    })
  })
</script>
