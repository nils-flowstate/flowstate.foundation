---
import WhatsAppButton from '../ui/WhatsAppButton.astro'
import Button from '../ui/Button.astro'
import PhoneInput from '../islands/PhoneInput'
import { getMessages, localizePath, useTranslations, type Lang } from '../../i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---
<section class="bg-white py-20 px-4">
  <div data-stagger class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <!-- Photo -->
    <div class="reveal order-first">
      <img
        src="/assets/nils.webp"
        alt="Nils Tenkotte – Flowstate Foundation"
        class="w-full max-w-sm mx-auto rounded-2xl shadow-lg object-cover aspect-[3/4]"
        loading="lazy"
      />
    </div>

    <!-- Text -->
    <div class="space-y-5">
      <h2 class="reveal font-display text-2xl sm:text-3xl font-bold text-navy">
        {t('about.greeting')}
      </h2>

      {[1, 2, 3].map(n => (
        <div class="reveal space-y-1">
          <p class="font-sans font-semibold text-navy">{t(`about.subhead${n}`)}</p>
          <p class="font-sans text-text leading-relaxed">{t(`about.line${n}`)}</p>
        </div>
      ))}

      <div class="reveal border-t border-gray-100 pt-6 space-y-4">
        <p class="font-sans font-semibold text-navy">{t('about.interest')}</p>
        <PhoneInput client:visible source="about" lang={lang} messages={getMessages(lang, 'forms')} />

        <!-- <div class="flex items-center gap-4">
          <div class="flex-1 h-px bg-gray-100" />
          <span class="font-sans text-sm text-muted">{t('about.orDivider')}</span>
          <div class="flex-1 h-px bg-gray-100" />
        </div> -->

        <div class="flex flex-col sm:flex-row gap-3">
          <WhatsAppButton label={t('about.waButton')} message="Liebe in den Äther <3" />
          <Button href={localizePath('about', lang)} variant="ghost" class="text-navy border border-navy-400 hover-border:bg-navy">
            {t('about.moreLink')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
