---
import { ArrowLeft } from 'lucide-react'
import BaseLayout from '../layouts/BaseLayout.astro'
import WhatsAppButton from '../components/ui/WhatsAppButton.astro'
import Button from '../components/ui/Button.astro'
import { localizePath, useTranslations, type Lang } from '../i18n/utils'
import { VALUES } from '../i18n/values'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const sections = VALUES.map((value, i) => ({
  ...value,
  k: `values.items.${value.key}`,
  id: t(`values.items.${value.key}.anchor`),
  bg: i % 2 === 1 ? 'bg-surface' : 'bg-white',
}))
---
<BaseLayout lang={lang} title={t('values.pageIntro')} description={t('values.pageSub')}>
  <!-- Hero -->
  <section class="bg-navy pt-28 pb-16 px-4 text-center">
    <h1 class="enter font-display text-3xl sm:text-4xl font-bold text-white mb-4">
      {t('values.pageIntro')}
    </h1>
    <p class="enter font-display italic text-lg sm:text-xl text-white/70" style="--delay:0.15s">
      {t('values.pageSub')}
    </p>
  </section>

  <!-- Sticky subnav -->
  <div class="sticky z-30 bg-white border-b border-gray-100 shadow-xs transition-[top] duration-300 top-16 [.header-hidden_&]:top-0">
    <div class="max-w-5xl mx-auto px-4 flex items-center gap-1 py-2">
      <a
        href={localizePath('home', lang)}
        class="flex items-center gap-1.5 px-3 py-2 rounded-xl font-sans text-sm text-muted hover:bg-surface hover:text-text transition-colors mr-1"
      >
        <ArrowLeft className="w-4 h-4" />
        <span class="hidden sm:inline">{t('nav.home')}</span>
      </a>
      <div class="w-px h-5 bg-gray-200 mr-1"></div>
      {sections.map((section, i) => (
        <a
          href={`#${section.id}`}
          data-subnav={section.id}
          aria-current={i === 0 ? 'true' : undefined}
          aria-label={t(`${section.k}.nav`)}
          class="flex items-center gap-2 px-4 py-2 rounded-xl font-sans text-sm font-medium transition-colors text-muted hover:bg-surface hover:text-text aria-[current=true]:bg-navy aria-[current=true]:text-white aria-[current=true]:hover:bg-navy aria-[current=true]:hover:text-white"
        >
          <section.Icon className="w-4 h-4" />
          <span class="hidden sm:inline">{t(`${section.k}.nav`)}</span>
        </a>
      ))}
    </div>
  </div>

  {sections.map(section => (
    <section id={section.id} data-section class={`py-20 px-4 scroll-mt-32 ${section.bg}`}>
      <div data-stagger class="max-w-3xl mx-auto">
        <div class="reveal flex items-center gap-3 mb-6">
          <section.Icon className={`w-10 h-10 shrink-0 ${section.iconColor}`} />
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-navy">{t(`${section.k}.title`)}</h2>
        </div>
        <p class="reveal font-sans font-semibold text-navy text-lg mb-2">{t(`${section.k}.tagline`)}</p>
        {t(`${section.k}.body`).split('\n').map(paragraph => (
          <p class="reveal font-sans text-text leading-relaxed mb-4">{paragraph}</p>
        ))}

        <div class="reveal border-t border-gray-100 pt-6 mt-8 flex flex-col sm:flex-row gap-3">
          <WhatsAppButton label={t(`${section.k}.ctaLabel`)} message={t(`whatsapp.${section.key}Message`)} />
          {section.key === 'empowerment' && (
            <Button href={localizePath('about', lang)} variant="ghost" class="text-navy border border-gray-200">
              {t('about.moreLink')}
            </Button>
          )}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  // Aktiver Subnav-Tab folgt der sichtbaren Section
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-subnav]')
  const setActive = (id: string) =>
    links.forEach(link =>
      link.dataset.subnav === id ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current')
    )

  const observer = new IntersectionObserver(
    entries => entries.forEach(e => e.isIntersecting && setActive(e.target.id)),
    { threshold: 0.4 }
  )
  document.querySelectorAll('[data-section]').forEach(section => observer.observe(section))
</script>
